node_modules/
dist/
.astro/

# Build artifacts — regenerated by `npm run build` in CI.
public/cv/
public/downloads/
public/media/og-image-*.png

# Local DB / editor leftovers
*.sqlite
*.db
.env
.env.*
!.env.example

# Session dumps — a logged-in HAR (or raw cookie) is a credential dump.
*.har
*.har.txt

# Imported third-party review artifacts (Jobgether, …) — local working input,
# not published with the CV.
docs/reviews/

.DS_Store
*.log

# Cover letter drafts — per-application, and often contain a company name you
# are not ready to announce. The template and applicant facts are committed.
cover-letters/applications/*.md
cover-letters/applications/*.txt
cover-letters/applications/*.yaml
!cover-letters/applications/example.yaml

# LinkedIn post drafts — per-project, written for you to review before posting.
# The README documents the convention; drafts stay local.
linkedin/drafts/*.md
