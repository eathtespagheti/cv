# syntax=docker/dockerfile:1

# ---- Build the Astro site ----------------------------------------------------
# `npm run build` is more than `astro build`: it also exports PDF/DOCX/TXT
# (needs a headless Chromium) and renders an OG image via a local preview server.
#
# The base image is Microsoft's official Playwright image, which ships Chromium
# and its OS dependencies preinstalled. The previous approach — `npm ci` then
# `npx playwright install chromium` on a plain Node image — downloaded ~120 MB
# from cdn.playwright.dev on every build, and that CDN is not reliably reachable
# from inside a Docker-in-Docker build. The official image removes that network
# dependency entirely.
#
# The tag MUST track the `playwright` version in package-lock.json. A mismatch
# means the bundled browser revision differs from the one Playwright expects.
# Currently: playwright 1.63.0 -> chromium-1243.
FROM mcr.microsoft.com/playwright:v1.63.0-noble AS build

# Canonical origin — drives <link rel=canonical>, hreflang and the sitemap.
ARG SITE_URL=https://cv.eathtespagheti.eu
ENV SITE_URL=$SITE_URL

WORKDIR /app

# --- Dependencies -------------------------------------------------------------
# Manifest first so this layer survives every source/content edit.
#
# Where BuildKit is available (buildx installed, e.g. CI), this can become
#   RUN --mount=type=cache,target=/root/.npm npm ci
# to reuse npm's tarball cache across builds. It is left off because the classic
# builder — the fallback when the buildx CLI plugin is absent, as in a plain
# `docker compose build` — rejects `--mount` outright.
COPY package.json package-lock.json ./
RUN npm ci

# --- CV data + resume exports -------------------------------------------------
# Only the inputs of `cv:build`, `resume:generate` and `resume:pdf` are copied
# here. Everything the site needs but the resumes do not — pages, components,
# styles, project case studies, docs — is copied further down, so editing any of
# it leaves these layers (including the headless-Chromium PDF export) cached.
#
# `public/cv/` is generated by cv:build and `public/downloads/` by the resume
# steps. The CV's `photo:` field points at public/media/profile.jpg — if that
# moves, copy the new path here too.
COPY src/content/cv ./src/content/cv
COPY src/content/profiles ./src/content/profiles
COPY src/content/languages ./src/content/languages
COPY src/scripts/merge.mjs ./src/scripts/merge.mjs
COPY src/scripts/resume-export-pdf.mjs ./src/scripts/resume-export-pdf.mjs
COPY .github/scripts/generate-resume.js ./.github/scripts/generate-resume.js
COPY public/media/profile.jpg ./public/media/profile.jpg

RUN npm run cv:build
RUN npm run resume:generate
# Recruiter PDF + ATS-safe PDF.
RUN npm run resume:pdf

# --- Site + OG image ----------------------------------------------------------
# Everything else. Any change here re-runs Astro and the OG render, but the
# resume layers above stay cached.
#
# Keep these steps in sync with the `build` script in package.json — CI's
# validate job still runs that script whole, so the two can drift silently.
COPY . .

RUN npm run astro -- build
RUN npm run og:generate

# ---- Serve the static output --------------------------------------------------
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
# Shared `add_header` snippet that nginx.conf `include`s in every context that
# sets a header of its own (the server block and the two cache locations).
# It must sit outside conf.d/ — a file there is loaded as a config fragment.
COPY nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf

EXPOSE 8080

# `default_type text/plain` in the /healthz location makes this a text response.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
